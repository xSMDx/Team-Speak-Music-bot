# ---------------------------------------------------------------- TeamSpeak
# Address of your TeamSpeak server (host or host:port). Use 127.0.0.1 if it runs on the same machine.
TS_HOST=127.0.0.1
TS_NICKNAME=MusicBot
# Server password (leave empty if none)
TS_SERVER_PASSWORD=
# Channel the bot joins on connect, e.g. "Music" or "Lounge/Music" (empty = default channel)
TS_CHANNEL=
TS_CHANNEL_PASSWORD=
# Walk back to its channel if someone channel-kicks the bot
TS_RETURN_TO_CHANNEL=true
# Identity security level (raise if your server demands more than 8)
TS_IDENTITY_LEVEL=8

# ---------------------------------------------------------------- Web UI
# Password for https://music.example.com  (CHANGE THIS)
WEB_PASSWORD=change-me-please
# The bot only listens locally; nginx publishes it on the domain
WEB_HOST=127.0.0.1
WEB_PORT=8090
PUBLIC_URL=https://music.example.com
# Max size per uploaded file (MB). Keep in sync with client_max_body_size in nginx.
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------- Audio / queue
DEFAULT_VOLUME=50
# Opus bitrate in kbit/s
AUDIO_BITRATE=96
# How many upcoming songs are downloaded ahead of time
PREFETCH=3
# Limit for YouTube/Spotify playlists and albums
MAX_PLAYLIST_ITEMS=200
# Reject songs longer than this many minutes (0 = no limit)
MAX_SONG_MINUTES=0
# Post "Now playing: ..." in the channel
ANNOUNCE_SONGS=true
COMMAND_PREFIX=/

# ---------------------------------------------------------------- Spotify (optional)
# Spotify links work without these (via Spotify's public embed page), but API keys are more
# reliable and allow playlists > 100 songs. Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------- yt-dlp (advanced)
# YTDLP_BIN=yt-dlp
# YTDLP_EXTRA_ARGS=--js-runtimes node
